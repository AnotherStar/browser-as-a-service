{
  "openapi": "3.1.0",
  "info": {
    "title": "browser-as-a-service",
    "description": "Generic browser automation over zendriver (undetected Chrome) with fingerprint masking and Asocks residential proxies. Run typed scenarios against bot-protected sites and get the DOM back; site-specific parsing and retry logic live in the caller.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/run": {
      "post": {
        "tags": [
          "scrape"
        ],
        "summary": "Run",
        "description": "Execute a scenario (list of steps) in a real Chrome and return the\nextracted data. Use `start_url` for the initial navigation.",
        "operationId": "run_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "List Sessions",
        "description": "List live warm sessions with age/idle/run counters.",
        "operationId": "list_sessions_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session",
        "description": "Launch a warm, proxied browser and keep it alive for reuse via\n`POST /run` with its `session_id`. Hold several (e.g. a small pool per\nmarketplace) to scrape batches in parallel without re-warming each card.",
        "operationId": "create_session_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions/{session_id}": {
      "delete": {
        "tags": [
          "sessions"
        ],
        "summary": "Delete Session",
        "description": "Tear down a warm session (stops its browser, frees the exit IP).",
        "operationId": "delete_session_sessions__session_id__delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Delete Session Sessions  Session Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClickStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "click",
            "title": "Action",
            "default": "click"
          },
          "selector": {
            "type": "string",
            "title": "Selector",
            "description": "CSS selector of element to click."
          },
          "timeout_s": {
            "type": "number",
            "maximum": 120.0,
            "exclusiveMinimum": 0.0,
            "title": "Timeout S",
            "default": 15.0
          }
        },
        "type": "object",
        "required": [
          "selector"
        ],
        "title": "ClickStep"
      },
      "Cookie": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Cookie name."
          },
          "value": {
            "type": "string",
            "title": "Value",
            "description": "Cookie value."
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain",
            "description": "Cookie domain, e.g. '.ozon.ru'. Defaults to the registrable domain of the first navigated URL.",
            "examples": [
              ".ozon.ru"
            ]
          },
          "path": {
            "type": "string",
            "title": "Path",
            "description": "Cookie path.",
            "default": "/"
          }
        },
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "title": "Cookie",
        "description": "A cookie set before the first navigation. Useful for pinning a\nmarketplace storefront to a region (e.g. Ozon/WB delivery region) so the\nprices and availability match what a buyer in that region sees."
      },
      "EvalStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "eval",
            "title": "Action",
            "default": "eval"
          },
          "expression": {
            "type": "string",
            "title": "Expression",
            "description": "JS expression; its value is captured."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Key to store the result under (omit to discard)."
          }
        },
        "type": "object",
        "required": [
          "expression"
        ],
        "title": "EvalStep",
        "description": "Run arbitrary JavaScript in the page and capture the returned value."
      },
      "ExtractStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "extract",
            "title": "Action",
            "default": "extract"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Key under which the result is returned."
          },
          "selector": {
            "type": "string",
            "title": "Selector",
            "description": "CSS selector."
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "html",
              "attr"
            ],
            "title": "Kind",
            "description": "What to read: visible text, innerHTML, or an attribute.",
            "default": "text"
          },
          "attr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attr",
            "description": "Attribute name (required when kind='attr')."
          },
          "many": {
            "type": "boolean",
            "title": "Many",
            "description": "If true, returns a list for all matches instead of the first.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name",
          "selector"
        ],
        "title": "ExtractStep",
        "description": "Extract values from the DOM via a CSS selector. Result is stored in\nthe response `data` under `name`."
      },
      "FindTextStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "find_text",
            "title": "Action",
            "default": "find_text"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Key under which the result is returned."
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Text to search for."
          },
          "timeout_s": {
            "type": "number",
            "maximum": 120.0,
            "exclusiveMinimum": 0.0,
            "title": "Timeout S",
            "default": 10.0
          }
        },
        "type": "object",
        "required": [
          "name",
          "text"
        ],
        "title": "FindTextStep",
        "description": "Find an element by its text (nodriver's smart text search) and store\nthe enclosing element's text."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "browser_ready": {
            "type": "boolean",
            "title": "Browser Ready"
          },
          "chrome_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chrome Path"
          }
        },
        "type": "object",
        "required": [
          "browser_ready"
        ],
        "title": "HealthResponse"
      },
      "NavigateStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "navigate",
            "title": "Action",
            "default": "navigate"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "URL to open."
          },
          "new_tab": {
            "type": "boolean",
            "title": "New Tab",
            "description": "Open in a new tab instead of reusing.",
            "default": false
          },
          "settle_seconds": {
            "type": "number",
            "maximum": 60.0,
            "minimum": 0.0,
            "title": "Settle Seconds",
            "description": "Seconds to wait after load for JS to settle.",
            "default": 3.0
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "NavigateStep"
      },
      "Proxy": {
        "properties": {
          "server": {
            "type": "string",
            "title": "Server",
            "description": "Proxy address, e.g. 'http://1.2.3.4:8080' or '1.2.3.4:8080'.",
            "examples": [
              "http://1.2.3.4:8080"
            ]
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username",
            "description": "Proxy username (optional)."
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Proxy password (optional)."
          }
        },
        "type": "object",
        "required": [
          "server"
        ],
        "title": "Proxy",
        "description": "A single proxy. Authenticated proxies are handled via CDP Fetch,\nso user/pass do NOT need to be embedded in the server URL."
      },
      "RunRequest": {
        "properties": {
          "steps": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/NavigateStep"
                },
                {
                  "$ref": "#/components/schemas/WaitForStep"
                },
                {
                  "$ref": "#/components/schemas/WaitForAnyStep"
                },
                {
                  "$ref": "#/components/schemas/WaitForEvalStep"
                },
                {
                  "$ref": "#/components/schemas/WaitForTextStep"
                },
                {
                  "$ref": "#/components/schemas/SleepStep"
                },
                {
                  "$ref": "#/components/schemas/ClickStep"
                },
                {
                  "$ref": "#/components/schemas/ScrollStep"
                },
                {
                  "$ref": "#/components/schemas/ExtractStep"
                },
                {
                  "$ref": "#/components/schemas/FindTextStep"
                },
                {
                  "$ref": "#/components/schemas/EvalStep"
                },
                {
                  "$ref": "#/components/schemas/ScreenshotStep"
                }
              ],
              "discriminator": {
                "propertyName": "action",
                "mapping": {
                  "click": "#/components/schemas/ClickStep",
                  "eval": "#/components/schemas/EvalStep",
                  "extract": "#/components/schemas/ExtractStep",
                  "find_text": "#/components/schemas/FindTextStep",
                  "navigate": "#/components/schemas/NavigateStep",
                  "screenshot": "#/components/schemas/ScreenshotStep",
                  "scroll": "#/components/schemas/ScrollStep",
                  "sleep": "#/components/schemas/SleepStep",
                  "wait_for": "#/components/schemas/WaitForStep",
                  "wait_for_any": "#/components/schemas/WaitForAnyStep",
                  "wait_for_eval": "#/components/schemas/WaitForEvalStep",
                  "wait_for_text": "#/components/schemas/WaitForTextStep"
                }
              }
            },
            "type": "array",
            "minItems": 1,
            "title": "Steps",
            "description": "Ordered list of steps."
          },
          "start_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Url",
            "description": "Convenience: navigate here before running steps (equivalent to a leading navigate step)."
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Reuse a warm session created via POST /sessions (its already-launched, proxied, anti-bot-warmed browser). Skips the per-run browser launch + warmup + teardown — the big latency win for batches. Unknown/expired id -> HTTP 404 (caller should re-create and retry). Omit to run one-off (a fresh proxied browser is spun up just for it)."
          },
          "proxy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Proxy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explicit proxy for a one-off run (ignored when session_id is set). Omit to auto-resolve an Asocks residential proxy."
          },
          "cookies": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Cookie"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cookies",
            "description": "Cookies set before the first navigation (e.g. region pinning). Domain defaults to the start_url's registrable domain."
          },
          "headless": {
            "type": "boolean",
            "title": "Headless",
            "description": "Headless Chrome. NOTE: Ozon blocks headless — keep this false.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "steps"
        ],
        "title": "RunRequest",
        "examples": [
          {
            "start_url": "https://www.ozon.ru/product/example-123456/",
            "steps": [
              {
                "action": "wait_for",
                "selector": "[data-widget=webPrice]"
              },
              {
                "action": "extract",
                "kind": "text",
                "name": "price",
                "selector": "[data-widget=webPrice]"
              },
              {
                "action": "extract",
                "name": "title",
                "selector": "h1"
              }
            ]
          }
        ]
      },
      "RunResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "final_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Url"
          },
          "elapsed_ms": {
            "type": "integer",
            "title": "Elapsed Ms"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "Extracted values keyed by step `name`."
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepResult"
            },
            "type": "array",
            "title": "Steps"
          },
          "timings": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Timings",
            "description": "Phase breakdown of elapsed_ms, in milliseconds: `proxy_ms` (resolving an Asocks proxy), `acquire_ms` (throttle wait + browser/tab setup before the first step), `steps_ms` (running the scenario). The remainder up to elapsed_ms is final-URL read + overhead."
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "elapsed_ms"
        ],
        "title": "RunResponse"
      },
      "ScreenshotStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "screenshot",
            "title": "Action",
            "default": "screenshot"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Key under which the base64 image is returned."
          },
          "full_page": {
            "type": "boolean",
            "title": "Full Page",
            "description": "Capture the full page vs viewport.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ScreenshotStep"
      },
      "ScrollStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "scroll",
            "title": "Action",
            "default": "scroll"
          },
          "direction": {
            "type": "string",
            "enum": [
              "down",
              "up"
            ],
            "title": "Direction",
            "default": "down"
          },
          "amount": {
            "type": "integer",
            "title": "Amount",
            "description": "Scroll amount (percent of viewport) per step.",
            "default": 50
          },
          "times": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Times",
            "description": "How many times to scroll.",
            "default": 1
          }
        },
        "type": "object",
        "title": "ScrollStep"
      },
      "SessionCreateRequest": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label",
            "description": "Free-form tag for the caller's bookkeeping, e.g. the marketplace ('OZON'/'WB'/'YM'). Echoed back in session info; does not affect behaviour.",
            "examples": [
              "OZON"
            ]
          },
          "proxy_country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proxy Country",
            "description": "ISO country code for the Asocks exit IP. Omit to use the server default.",
            "examples": [
              "RU"
            ]
          },
          "proxy_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proxy Type",
            "description": "Asocks proxy type for the exit IP: 'residential', 'mixed', 'mobile' (4G), or 'corporate'. Omit to use the server default ('mixed'). Use 'mobile' for sites that captcha datacenter/residential IPs (e.g. Yandex.Market). An unknown value is a 400.",
            "examples": [
              "mobile"
            ]
          },
          "warmup": {
            "type": "boolean",
            "title": "Warmup",
            "description": "Visit the warmup URL once after launch to prime anti-bot cookies before the first real navigation.",
            "default": true
          },
          "warmup_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warmup Url",
            "description": "Optional session-specific warmup URL. Omit to use the server WARMUP_URL default. Useful when a caller keeps separate warm sessions per marketplace."
          },
          "warmup_settle_s": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 60.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Warmup Settle S",
            "description": "Optional settle delay after the session-specific warmup URL."
          }
        },
        "type": "object",
        "title": "SessionCreateRequest",
        "description": "Create a warm, proxied browser kept alive for reuse across runs."
      },
      "SessionInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "exit_server": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Server",
            "description": "The proxy gateway host:port backing this session."
          },
          "created_ts": {
            "type": "number",
            "title": "Created Ts",
            "description": "Unix epoch seconds at creation."
          },
          "last_used_ts": {
            "type": "number",
            "title": "Last Used Ts",
            "description": "Unix epoch seconds of last run."
          },
          "age_s": {
            "type": "integer",
            "title": "Age S",
            "description": "Seconds since creation."
          },
          "idle_s": {
            "type": "integer",
            "title": "Idle S",
            "description": "Seconds since the last run."
          },
          "runs": {
            "type": "integer",
            "title": "Runs",
            "description": "Runs served by this session so far."
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_ts",
          "last_used_ts",
          "age_s",
          "idle_s",
          "runs"
        ],
        "title": "SessionInfo"
      },
      "SessionListResponse": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionInfo"
            },
            "type": "array",
            "title": "Sessions"
          }
        },
        "type": "object",
        "title": "SessionListResponse"
      },
      "SleepStep": {
        "properties": {
          "action": {
            "type": "string",
            "const": "sleep",
            "title": "Action",
            "default": "sleep"
          },
          "seconds": {
            "type": "number",
            "maximum": 60.0,
            "exclusiveMinimum": 0.0,
            "title": "Seconds"
          }
        },
        "type": "object",
        "required": [
          "seconds"
        ],
        "title": "SleepStep"
      },
      "StepResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms",
            "description": "Wall-clock time spent on this step, in milliseconds.",
