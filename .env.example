# Copy to .env and fill in. Loaded from the project root by service/app/settings.py.

# --- Asocks proxy provider (https://api.asocks.com/v2) ---
# API key from the Asocks dashboard. Enables `use_asocks: true` on /run and
# /ozon/price so a request can be routed through a residential proxy.
ASOCKS_API_KEY=
# Optional overrides:
# ASOCKS_BASE_URL=https://api.asocks.com/v2
# ASOCKS_TIMEOUT_S=30
# ASOCKS_POOL_TTL_S=300   # how long a resolved port is reused before re-querying
# IGNORE_PROXY=1          # force direct local runs/sessions even when proxies are configured

# --- Browser / anti-ban (all optional; defaults in settings.py) ---
# CHROME_PATH=
# MAX_CONCURRENCY=3
# MIN_INTERVAL_S=2.0
# JITTER_S=1.5
# HEADLESS=0
# BROWSER_CONNECTION_TIMEOUT_S=0.5
# BROWSER_CONNECTION_MAX_TRIES=30
# WARMUP_URL=https://www.ozon.ru/
# WARMUP_SETTLE_S=4.0
# RUN_TIMEOUT_S=90
# REQUEST_TIMEOUT_S=150
